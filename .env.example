# Preferred LLM for answers and reranking: "ollama" (default) or "gemini".
# After changing this value, restart the server.
LLM_PROVIDER=ollama
# Set to true temporarily to log provider attempts and Gemini request details.
LLM_DEBUG=false

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini settings (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Optional fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
